From: OpenSolo <decryptortuning@gmail.com>
Subject: [PATCH] power: reset: register OpenSolo controller power holds

Retain bootloader power holds through MCU reset and release at final power-off.

Upstream-Status: Inappropriate [OpenSolo board support]
---
 drivers/power/reset/Kconfig  | 8 ++++++++
 drivers/power/reset/Makefile | 1 +
 2 files changed, 9 insertions(+)

diff --git a/drivers/power/reset/Kconfig b/drivers/power/reset/Kconfig
--- a/drivers/power/reset/Kconfig
+++ b/drivers/power/reset/Kconfig
@@ -9,6 +9,14 @@ menuconfig POWER_RESET
 
 if POWER_RESET
 
+config POWER_RESET_OPENSOLO_CONTROLLER
+	bool "OpenSolo controller power holds"
+	depends on OF && GPIOLIB
+	depends on ARCH_MXC || COMPILE_TEST
+	help
+	  Retain the two controller power holds through MCU reset and Linux
+	  reboot, releasing them only at final power-off.
+
 config POWER_RESET_AS3722
 	bool "ams AS3722 power-off driver"
 	depends on MFD_AS3722
diff --git a/drivers/power/reset/Makefile b/drivers/power/reset/Makefile
--- a/drivers/power/reset/Makefile
+++ b/drivers/power/reset/Makefile
@@ -1,3 +1,4 @@
 # SPDX-License-Identifier: GPL-2.0
+obj-$(CONFIG_POWER_RESET_OPENSOLO_CONTROLLER) += opensolo-controller-power.o
 obj-$(CONFIG_POWER_RESET_AS3722) += as3722-poweroff.o
 obj-$(CONFIG_POWER_RESET_AT91_POWEROFF) += at91-poweroff.o
